// ════════════════════════════════════════════════════════════════════
//  ระบบจัดการปู v2 (ขายแบบสมาชิก) — Prisma schema (MySQL)
//  แผนเต็ม: docs/v2-plan.md · schema v1 อยู่ที่ tag v1-final
//
//  เพิ่มทีละเฟส:
//    P1            บัญชีผู้ใช้ · แพ็กเกจ/สมาชิก · สลิปโอนเงิน · ตั้งค่าร้าน
//    P2            ระบบปู · กล่อง · คู่ค้า · ล็อต · ปู · การเช็คปู
//    P3            แจ้งเตือน (กฎ/งาน/อีเมล)
//    P4–P9         อาหาร · น้ำ · ขาย/บัญชี · ชุมชน · หมู่บ้านฟาร์ม
// ════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  // migrate dev ต้องมี shadow DB (shared hosting สร้าง DB เองไม่ได้)
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────
//  บัญชีผู้ใช้
// ─────────────────────────────────────────────────────────────────────

model User {
  id           Int        @id @default(autoincrement())
  /// ใช้ล็อกอิน — LINE ที่ไม่ให้อีเมลจะได้อีเมลเทียม line_<id>@oauth.local
  email        String     @unique
  name         String?
  passwordHash String? // null = ล็อกอินผ่าน Google/LINE/Facebook อย่างเดียว
  role         Role       @default(USER)
  avatarUrl    String?    @db.Text
  /// false = แอดมินระงับบัญชี (ล็อกอินไม่ได้)
  active       Boolean    @default(true)
  /// อีเมลรับแจ้งเตือน — เว้นว่าง = ไม่ส่งอีเมล (แยกจากอีเมลล็อกอินโดยตั้งใจ)
  notifyEmail  String?
  /// หน่วยน้ำหนักที่แสดงทั้งระบบ — ข้อมูลเก็บเป็นกรัมเสมอ
  weightUnit   WeightUnit @default(KHIT)
  /// ค่าส่วนตัวของหน้าเว็บ { themeFamily, themeMode, sound, reduceMotion, dashboard, tours } — ห้ามส่งให้คนอื่นเห็น
  uiPrefs      Json?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  oauthAccounts        OAuthAccount[]
  refreshTokens        RefreshToken[]
  subscriptions        Subscription[] @relation("SubscriptionUser")
  grantedSubscriptions Subscription[] @relation("SubscriptionGrantedBy")
  paymentSlips         PaymentSlip[]  @relation("SlipUser")
  reviewedSlips        PaymentSlip[]  @relation("SlipReviewer")

  // ── ฟาร์ม (P2) — ข้อมูลฟาร์มเห็นได้เฉพาะเจ้าของ (แอดมินก็ไม่เห็นฟาร์มลูกค้า) ──
  crabSystems CrabSystem[]
  contacts    Contact[]
  crabLots    CrabLot[]
  crabs       Crab[]
}

enum Role {
  ADMIN // เจ้าของระบบ (คุณ) — เข้าหลังบ้านได้ ไม่ต้องมีแพ็กเกจ
  USER // ลูกค้าคนเลี้ยงปู
}

enum WeightUnit {
  KHIT // ขีด (100 กรัม)
  GRAM
}

model OAuthAccount {
  id                Int           @id @default(autoincrement())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            Int
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum OAuthProvider {
  GOOGLE
  LINE
  FACEBOOK
}

/// refresh token เก็บเป็น sha256 (revoke ได้ + rotate ทุกครั้งที่ refresh)
model RefreshToken {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?   @db.Text
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────
//  แพ็กเกจ / สมาชิก / สลิปโอนเงิน
//  "ใช้งานได้" = มี Subscription ที่ยังไม่ถูกยกเลิก และ startsAt <= ตอนนี้
//  และ (expiresAt = null [ซื้อขาด] หรือ ตอนนี้ < expiresAt + ช่วงผ่อนผัน)
// ─────────────────────────────────────────────────────────────────────

model Plan {
  id           Int      @id @default(autoincrement())
  code         String   @unique // MONTHLY / YEARLY / LIFETIME (แอดมินเพิ่มเองได้)
  name         String // ข้อความที่ลูกค้าเห็น เช่น "รายเดือน"
  description  String?  @db.Text
  priceTHB     Decimal  @db.Decimal(12, 2)
  /// จำนวนวันที่ได้ — null = ซื้อขาด (ไม่หมดอายุ)
  durationDays Int?
  active       Boolean  @default(true) // false = ซ่อนจากหน้าเลือกแพ็กเกจ
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  paymentSlips  PaymentSlip[]
}

model Subscription {
  id          Int                @id @default(autoincrement())
  user        User               @relation("SubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  plan        Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId      Int? // null = แอดมินให้เองแบบกำหนดวัน (ทดลองใช้)
  startsAt    DateTime
  expiresAt   DateTime? // null = ซื้อขาด
  source      SubscriptionSource
  /// สลิปที่ทำให้เกิดสิทธิ์นี้ (ถ้ามา)
  slip        PaymentSlip?       @relation(fields: [slipId], references: [id], onDelete: SetNull)
  slipId      Int?               @unique
  grantedBy   User?              @relation("SubscriptionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedById Int?
  revokedAt   DateTime? // แอดมินยกเลิกสิทธิ์
  note        String?            @db.Text
  createdAt   DateTime           @default(now())

  @@index([userId, expiresAt])
}

enum SubscriptionSource {
  SLIP // ลูกค้าอัปสลิป แอดมินอนุมัติ
  MANUAL // แอดมินให้เอง (จ่ายช่องทางอื่น / เพื่อน)
  TRIAL // ทดลองใช้
}

model PaymentSlip {
  id            Int        @id @default(autoincrement())
  user          User       @relation("SlipUser", fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  plan          Plan       @relation(fields: [planId], references: [id])
  planId        Int
  amount        Decimal    @db.Decimal(12, 2) // ยอดที่ลูกค้าบอกว่าโอน
  imageUrl      String     @db.Text
  imagePublicId String?
  note          String?    @db.Text // ลูกค้าเขียนเพิ่ม
  status        SlipStatus @default(PENDING)
  reviewNote    String?    @db.Text // เหตุผลที่แอดมินปฏิเสธ / โน้ต
  reviewedBy    User?      @relation("SlipReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById  Int?
  reviewedAt    DateTime?
  createdAt     DateTime   @default(now())

  subscription Subscription?

  @@index([status, createdAt])
  @@index([userId])
}

enum SlipStatus {
  PENDING
  APPROVED
  REJECTED
}

/// ตั้งค่าของร้าน (คุณ) แบบ key → JSON เช่น key "shop" = { promptPayId, phone, facebookName, facebookUrl, lineOaUrl, graceDays }
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────
//  ฟาร์ม (P2) — ระบบปู · กล่อง · คู่ค้า · ล็อต · ปู · การเช็คปู
// ─────────────────────────────────────────────────────────────────────

/// ระบบปู = ชุดเลี้ยง 1 ชุด (ระบบน้ำ/กรองแยกกัน = คนละระบบ)
model CrabSystem {
  id        Int          @id @default(autoincrement())
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   Int
  name      String
  layout    SystemLayout
  /// จำนวนชั้น (คอนโด) หรือจำนวนแถว (ตะกร้า) — ต่อด้าน
  rows      Int
  /// จำนวนช่องต่อชั้น — ต่อด้าน
  cols      Int
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  boxes CrabBox[]
  lots  CrabLot[]
  crabs Crab[]

  @@index([ownerId])
}

enum SystemLayout {
  BASKET // ตะกร้าดำ
  CONDO_SINGLE // ปูคอนโดด้านเดียว
  CONDO_DOUBLE // ปูคอนโดหันหลังชนกัน (มีด้านหน้า + ด้านหลัง)
}

/// กล่อง/ตะกร้า 1 ช่อง — รหัสแบบ A1 (แถว A = ชั้นบนสุด) ไม่ซ้ำภายในด้านเดียวกัน
model CrabBox {
  id        Int        @id @default(autoincrement())
  system    CrabSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  systemId  Int
  side      BoxSide    @default(FRONT)
  row       Int // 0 = ชั้นบนสุด
  col       Int // 0 = ซ้ายสุด (มองจากด้านที่ยืน)
  code      String
  /// false = ถูกลดขนาดผังออกไปแล้ว (เก็บแถวไว้เพราะมีประวัติปูอ้างถึง)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  crabs Crab[]

  @@unique([systemId, side, row, col])
  @@unique([systemId, side, code])
}

enum BoxSide {
  FRONT
  BACK
}

/// คู่ค้า: คนขายปูให้เรา (SELLER) / ลูกค้าที่ซื้อปู (CUSTOMER — ใช้ใน P6)
model Contact {
  id        Int         @id @default(autoincrement())
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   Int
  type      ContactType
  name      String
  phone     String?
  note      String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lots CrabLot[]

  @@index([ownerId, type])
}

enum ContactType {
  SELLER
  CUSTOMER
}

/// ล็อตปู = ปูที่ซื้อเข้ามาพร้อมกัน 1 ครั้ง — ปูทุกตัวต้องอยู่ในล็อต (กันลืมใส่ต้นทุน)
model CrabLot {
  id            Int        @id @default(autoincrement())
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       Int
  system        CrabSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  systemId      Int
  seller        Contact?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerId      Int?
  receivedAt    DateTime
  /// ราคาที่จ่ายทั้งล็อต — null = ยังไม่ได้ใส่ (ขึ้น ⚠ จนกว่าจะใส่)
  totalCost     Decimal?   @db.Decimal(12, 2)
  costEnteredAt DateTime?
  note          String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  crabs Crab[]

  @@index([ownerId, receivedAt])
}

/// ปู 1 ตัว — ค่า last* เป็นสำเนาจากการเช็คล่าสุด (ไว้วาดผังกล่องเร็วๆ ไม่ต้อง join)
model Crab {
  id            Int        @id @default(autoincrement())
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       Int
  system        CrabSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  systemId      Int
  box           CrabBox?   @relation(fields: [boxId], references: [id], onDelete: SetNull)
  boxId         Int?
  // Cascade เพื่อให้ลบบัญชีผู้ใช้ได้ (การลบล็อตที่ยังมีปูถูกกันไว้ใน lot.service แล้ว)
  lot           CrabLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotId         Int
  /// รหัสไม่ซ้ำต่อเจ้าของ (C0001) — ซ่อนจากหน้าจอ ชื่อซ้ำกันได้
  code          String
  /// ค่าเริ่มต้น = รหัสกล่อง เช่น "A1"
  name          String
  type          CrabType
  sex           CrabSex?
  grade         CrabGrade?
  cableTieColor String?
  status        CrabStatus @default(ALIVE)
  /// ต้นทุนของตัวนี้ (แบ่งจากราคาล็อตตามน้ำหนักให้อัตโนมัติ)
  allocatedCost Decimal?   @db.Decimal(12, 2)
  lastWeightG   Decimal?   @db.Decimal(8, 1)
  /// % ไข่ (ปูไข่) หรือ % เนื้อ (ปูเนื้อ)
  lastPct       Int?
  lastPhotoUrl  String?    @db.Text
  lastCheckedAt DateTime?
  diedAt        DateTime?
  note          String?    @db.Text
  /// ลบเพราะบันทึกผิด (ไม่ใช่ตาย/ขาย) — ซ่อนจากทุกหน้า
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  checks CrabCheck[]

  @@unique([ownerId, code])
  @@index([systemId, status, deletedAt])
  @@index([lotId])
}

enum CrabType {
  EGG // ปูไข่
  MEAT // ปูเนื้อ
  SOFT // ปูนิ่ม
}

enum CrabSex {
  MALE // ผู้
  FEMALE // เมีย
  INTERSEX // กะเทย
}

enum CrabGrade {
  A // สมบูรณ์
  B // ไม่สมบูรณ์
}

enum CrabStatus {
  ALIVE // ยังเลี้ยงอยู่
  SOLD // ขายแล้ว (P6)
  DEAD // ตาย
}

/// การเช็คปู 1 ครั้ง (ชั่ง/ส่องไข่/ถ่ายรูป) — "เช็ควันนี้" = เพิ่มแถวใหม่เสมอ ไม่ทับของเดิม
model CrabCheck {
  id            Int      @id @default(autoincrement())
  crab          Crab     @relation(fields: [crabId], references: [id], onDelete: Cascade)
  crabId        Int
  checkedAt     DateTime
  weightG       Decimal? @db.Decimal(8, 1)
  pct           Int?
  /// % ที่ AI ประเมินจากรูป (เก็บคู่กับค่าที่ผู้ใช้ยืนยัน → รู้ว่า AI แม่นแค่ไหน)
  aiPct         Int?
  photoUrl      String?  @db.Text
  photoPublicId String?
  note          String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([crabId, checkedAt])
}
