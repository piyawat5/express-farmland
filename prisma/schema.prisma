// ════════════════════════════════════════════════════════════════════
//  ระบบจัดการปู v2 (ขายแบบสมาชิก) — Prisma schema (MySQL)
//  แผนเต็ม: docs/v2-plan.md · schema v1 อยู่ที่ tag v1-final
//
//  เพิ่มทีละเฟส:
//    P1            บัญชีผู้ใช้ · แพ็กเกจ/สมาชิก · สลิปโอนเงิน · ตั้งค่าร้าน
//    P2            ระบบปู · กล่อง · คู่ค้า · ล็อต · ปู · การเช็คปู
//    P3            แจ้งเตือน (กฎ/งาน/อีเมลตามเวลา)
//    P4            อาหาร (สต็อก · แผน · รอบให้อาหาร · ผลการกินรายตัว)
//    P5–P9         น้ำ · ขาย/บัญชี · ชุมชน · หมู่บ้านฟาร์ม
// ════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  // migrate dev ต้องมี shadow DB (shared hosting สร้าง DB เองไม่ได้)
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────
//  บัญชีผู้ใช้
// ─────────────────────────────────────────────────────────────────────

model User {
  id           Int        @id @default(autoincrement())
  /// ใช้ล็อกอิน — LINE ที่ไม่ให้อีเมลจะได้อีเมลเทียม line_<id>@oauth.local
  email        String     @unique
  name         String?
  passwordHash String? // null = ล็อกอินผ่าน Google/LINE/Facebook อย่างเดียว
  role         Role       @default(USER)
  avatarUrl    String?    @db.Text
  /// false = แอดมินระงับบัญชี (ล็อกอินไม่ได้)
  active       Boolean    @default(true)
  /// อีเมลรับแจ้งเตือน — เว้นว่าง = ไม่ส่งอีเมล (แยกจากอีเมลล็อกอินโดยตั้งใจ)
  notifyEmail  String?
  /// หน่วยน้ำหนักที่แสดงทั้งระบบ — ข้อมูลเก็บเป็นกรัมเสมอ
  weightUnit   WeightUnit @default(KHIT)
  /// ชั่วโมงที่ส่งอีเมลสรุปงานค้าง (P3) เช่น "8,12,16,20" — ว่าง = ไม่ส่งตามเวลา
  emailHours   String     @default("8,12,16,20")
  /// ส่งอีเมลสรุปครั้งล่าสุด (กันส่งซ้ำในชั่วโมงเดียวกัน — scheduler วิ่งทุก 15 นาที)
  lastDigestAt DateTime?
  /// ค่าส่วนตัวของหน้าเว็บ { themeFamily, themeMode, sound, reduceMotion, dashboard, tours } — ห้ามส่งให้คนอื่นเห็น
  uiPrefs      Json?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  oauthAccounts        OAuthAccount[]
  refreshTokens        RefreshToken[]
  subscriptions        Subscription[] @relation("SubscriptionUser")
  grantedSubscriptions Subscription[] @relation("SubscriptionGrantedBy")
  paymentSlips         PaymentSlip[]  @relation("SlipUser")
  reviewedSlips        PaymentSlip[]  @relation("SlipReviewer")

  // ── ฟาร์ม (P2) — ข้อมูลฟาร์มเห็นได้เฉพาะเจ้าของ (แอดมินก็ไม่เห็นฟาร์มลูกค้า) ──
  crabSystems CrabSystem[]
  contacts    Contact[]
  crabLots    CrabLot[]
  crabs       Crab[]

  // ── แจ้งเตือน (P3) ──
  reminderRules ReminderRule[]
  tasks         Task[]

  // ── อาหารปู (P4) ──
  feedItems     FeedItem[]
  feedMoves     FeedStockMove[]
  feedingPlans  FeedingPlan[]
  feedingRounds FeedingRound[]
}

enum Role {
  ADMIN // เจ้าของระบบ (คุณ) — เข้าหลังบ้านได้ ไม่ต้องมีแพ็กเกจ
  USER // ลูกค้าคนเลี้ยงปู
}

enum WeightUnit {
  KHIT // ขีด (100 กรัม)
  GRAM
}

model OAuthAccount {
  id                Int           @id @default(autoincrement())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            Int
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum OAuthProvider {
  GOOGLE
  LINE
  FACEBOOK
}

/// refresh token เก็บเป็น sha256 (revoke ได้ + rotate ทุกครั้งที่ refresh)
model RefreshToken {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?   @db.Text
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────
//  แพ็กเกจ / สมาชิก / สลิปโอนเงิน
//  "ใช้งานได้" = มี Subscription ที่ยังไม่ถูกยกเลิก และ startsAt <= ตอนนี้
//  และ (expiresAt = null [ซื้อขาด] หรือ ตอนนี้ < expiresAt + ช่วงผ่อนผัน)
// ─────────────────────────────────────────────────────────────────────

model Plan {
  id           Int      @id @default(autoincrement())
  code         String   @unique // MONTHLY / YEARLY / LIFETIME (แอดมินเพิ่มเองได้)
  name         String // ข้อความที่ลูกค้าเห็น เช่น "รายเดือน"
  description  String?  @db.Text
  priceTHB     Decimal  @db.Decimal(12, 2)
  /// จำนวนวันที่ได้ — null = ซื้อขาด (ไม่หมดอายุ)
  durationDays Int?
  active       Boolean  @default(true) // false = ซ่อนจากหน้าเลือกแพ็กเกจ
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
  paymentSlips  PaymentSlip[]
}

model Subscription {
  id          Int                @id @default(autoincrement())
  user        User               @relation("SubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  plan        Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId      Int? // null = แอดมินให้เองแบบกำหนดวัน (ทดลองใช้)
  startsAt    DateTime
  expiresAt   DateTime? // null = ซื้อขาด
  source      SubscriptionSource
  /// สลิปที่ทำให้เกิดสิทธิ์นี้ (ถ้ามา)
  slip        PaymentSlip?       @relation(fields: [slipId], references: [id], onDelete: SetNull)
  slipId      Int?               @unique
  grantedBy   User?              @relation("SubscriptionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  grantedById Int?
  revokedAt   DateTime? // แอดมินยกเลิกสิทธิ์
  note        String?            @db.Text
  createdAt   DateTime           @default(now())

  @@index([userId, expiresAt])
}

enum SubscriptionSource {
  SLIP // ลูกค้าอัปสลิป แอดมินอนุมัติ
  MANUAL // แอดมินให้เอง (จ่ายช่องทางอื่น / เพื่อน)
  TRIAL // ทดลองใช้
}

model PaymentSlip {
  id            Int        @id @default(autoincrement())
  user          User       @relation("SlipUser", fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  plan          Plan       @relation(fields: [planId], references: [id])
  planId        Int
  amount        Decimal    @db.Decimal(12, 2) // ยอดที่ลูกค้าบอกว่าโอน
  imageUrl      String     @db.Text
  imagePublicId String?
  note          String?    @db.Text // ลูกค้าเขียนเพิ่ม
  status        SlipStatus @default(PENDING)
  reviewNote    String?    @db.Text // เหตุผลที่แอดมินปฏิเสธ / โน้ต
  reviewedBy    User?      @relation("SlipReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById  Int?
  reviewedAt    DateTime?
  createdAt     DateTime   @default(now())

  subscription Subscription?

  @@index([status, createdAt])
  @@index([userId])
}

enum SlipStatus {
  PENDING
  APPROVED
  REJECTED
}

/// ตั้งค่าของร้าน (คุณ) แบบ key → JSON เช่น key "shop" = { promptPayId, phone, facebookName, facebookUrl, lineOaUrl, graceDays }
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────
//  ฟาร์ม (P2) — ระบบปู · กล่อง · คู่ค้า · ล็อต · ปู · การเช็คปู
// ─────────────────────────────────────────────────────────────────────

/// ระบบปู = ชุดเลี้ยง 1 ชุด (ระบบน้ำ/กรองแยกกัน = คนละระบบ)
model CrabSystem {
  id        Int          @id @default(autoincrement())
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   Int
  name      String
  layout    SystemLayout
  /// จำนวนชั้น (คอนโด) หรือจำนวนแถว (ตะกร้า) — ต่อด้าน
  rows      Int
  /// จำนวนช่องต่อชั้น — ต่อด้าน
  cols      Int
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  boxes         CrabBox[]
  lots          CrabLot[]
  crabs         Crab[]
  reminderRules ReminderRule[]
  tasks         Task[]
  feedingPlan   FeedingPlan?
  feedingRounds FeedingRound[]

  @@index([ownerId])
}

enum SystemLayout {
  BASKET // ตะกร้าดำ
  CONDO_SINGLE // ปูคอนโดด้านเดียว
  CONDO_DOUBLE // ปูคอนโดหันหลังชนกัน (มีด้านหน้า + ด้านหลัง)
}

/// กล่อง/ตะกร้า 1 ช่อง — รหัสแบบ A1 (แถว A = ชั้นบนสุด) ไม่ซ้ำภายในด้านเดียวกัน
model CrabBox {
  id        Int        @id @default(autoincrement())
  system    CrabSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  systemId  Int
  side      BoxSide    @default(FRONT)
  row       Int // 0 = ชั้นบนสุด
  col       Int // 0 = ซ้ายสุด (มองจากด้านที่ยืน)
  code      String
  /// false = ถูกลดขนาดผังออกไปแล้ว (เก็บแถวไว้เพราะมีประวัติปูอ้างถึง)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  crabs Crab[]

  @@unique([systemId, side, row, col])
  @@unique([systemId, side, code])
}

enum BoxSide {
  FRONT
  BACK
}

/// คู่ค้า: คนขายปูให้เรา (SELLER) / ลูกค้าที่ซื้อปู (CUSTOMER — ใช้ใน P6)
model Contact {
  id        Int         @id @default(autoincrement())
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   Int
  type      ContactType
  name      String
  phone     String?
  note      String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lots CrabLot[]

  @@index([ownerId, type])
}

enum ContactType {
  SELLER
  CUSTOMER
}

/// ล็อตปู = ปูที่ซื้อเข้ามาพร้อมกัน 1 ครั้ง — ปูทุกตัวต้องอยู่ในล็อต (กันลืมใส่ต้นทุน)
model CrabLot {
  id            Int        @id @default(autoincrement())
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       Int
  system        CrabSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  systemId      Int
  seller        Contact?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerId      Int?
  receivedAt    DateTime
  /// ราคาที่จ่ายทั้งล็อต — null = ยังไม่ได้ใส่ (ขึ้น ⚠ จนกว่าจะใส่)
  totalCost     Decimal?   @db.Decimal(12, 2)
  costEnteredAt DateTime?
  note          String?    @db.Text
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  crabs Crab[]

  @@index([ownerId, receivedAt])
}

/// ปู 1 ตัว — ค่า last* เป็นสำเนาจากการเช็คล่าสุด (ไว้วาดผังกล่องเร็วๆ ไม่ต้อง join)
model Crab {
  id            Int        @id @default(autoincrement())
  owner         User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       Int
  system        CrabSystem @relation(fields: [systemId], references: [id], onDelete: Cascade)
  systemId      Int
  box           CrabBox?   @relation(fields: [boxId], references: [id], onDelete: SetNull)
  boxId         Int?
  // Cascade เพื่อให้ลบบัญชีผู้ใช้ได้ (การลบล็อตที่ยังมีปูถูกกันไว้ใน lot.service แล้ว)
  lot           CrabLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotId         Int
  /// รหัสไม่ซ้ำต่อเจ้าของ (C0001) — ซ่อนจากหน้าจอ ชื่อซ้ำกันได้
  code          String
  /// ค่าเริ่มต้น = รหัสกล่อง เช่น "A1"
  name          String
  type          CrabType
  sex           CrabSex?
  grade         CrabGrade?
  cableTieColor String?
  status        CrabStatus @default(ALIVE)
  /// ต้นทุนของตัวนี้ (แบ่งจากราคาล็อตตามน้ำหนักให้อัตโนมัติ)
  allocatedCost Decimal?   @db.Decimal(12, 2)
  lastWeightG   Decimal?   @db.Decimal(8, 1)
  /// % ไข่ (ปูไข่) หรือ % เนื้อ (ปูเนื้อ)
  lastPct       Int?
  lastPhotoUrl  String?    @db.Text
  lastCheckedAt DateTime?
  diedAt        DateTime?
  note          String?    @db.Text
  /// ลบเพราะบันทึกผิด (ไม่ใช่ตาย/ขาย) — ซ่อนจากทุกหน้า
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  checks         CrabCheck[]
  feedingEntries FeedingEntry[]

  @@unique([ownerId, code])
  @@index([systemId, status, deletedAt])
  @@index([lotId])
}

enum CrabType {
  EGG // ปูไข่
  MEAT // ปูเนื้อ
  SOFT // ปูนิ่ม
}

enum CrabSex {
  MALE // ผู้
  FEMALE // เมีย
  INTERSEX // กะเทย
}

enum CrabGrade {
  A // สมบูรณ์
  B // ไม่สมบูรณ์
}

enum CrabStatus {
  ALIVE // ยังเลี้ยงอยู่
  SOLD // ขายแล้ว (P6)
  DEAD // ตาย
}

/// การเช็คปู 1 ครั้ง (ชั่ง/ส่องไข่/ถ่ายรูป) — "เช็ควันนี้" = เพิ่มแถวใหม่เสมอ ไม่ทับของเดิม
model CrabCheck {
  id            Int      @id @default(autoincrement())
  crab          Crab     @relation(fields: [crabId], references: [id], onDelete: Cascade)
  crabId        Int
  checkedAt     DateTime
  weightG       Decimal? @db.Decimal(8, 1)
  pct           Int?
  /// % ที่ AI ประเมินจากรูป (เก็บคู่กับค่าที่ผู้ใช้ยืนยัน → รู้ว่า AI แม่นแค่ไหน)
  aiPct         Int?
  photoUrl      String?  @db.Text
  photoPublicId String?
  note          String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([crabId, checkedAt])
}

// ─────────────────────────────────────────────────────────────────────
//  แจ้งเตือน (P3) — กฎ (ทำอะไร ทุกเมื่อไร สำคัญแค่ไหน) → งาน (1 รอบที่ต้องทำ)
//  - กฎ 1 ข้อมีงานเปิดได้ทีละ 1 งาน (Task.openKey) — ไม่ทำก็แค่ "เลยมา N วัน" ไม่กองซ้อน
//  - รอบถัดไปนับจากวันที่ทำจริง (บทเรียน v1: นับจากวันครบกำหนดเดิมแล้วงานเด้งถี่เกิน)
//  - ค่าเริ่มต้น 6 เรื่องสร้างตอนสร้างระบบปู (defaultKey) ลบไม่ได้ ได้แค่ปิด/ปรับรอบ/ปรับความสำคัญ
// ─────────────────────────────────────────────────────────────────────

model ReminderRule {
  id         Int          @id @default(autoincrement())
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    Int
  system     CrabSystem   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  systemId   Int
  kind       ReminderKind
  /// ค่าเริ่มต้นของระบบ (= ชื่อ kind) ลบไม่ได้ · เรื่องที่ผู้ใช้เพิ่มเอง = null
  defaultKey String?
  title      String
  /// อีโมจิหน้าเรื่อง
  icon       String?
  priority   Priority
  repeat     RepeatType
  /// ทุกกี่วัน (EVERY_DAYS) — งานเช็คปูใช้เป็น "รอบเช็คปูแต่ละตัว"
  everyDays  Int?
  /// วันในสัปดาห์ (WEEKDAYS) เช่น "1,4" — 0 = อาทิตย์
  weekdays   String?
  /// เวลาครบกำหนดในวันนั้น "HH:mm"
  timeOfDay  String       @default("08:00")
  active     Boolean      @default(true)
  /// รอบถัดไป (= dueAt ของงานที่เปิดอยู่ ถ้ามี) · null = ปิดอยู่/ยังไม่มีรอบ
  /// งานเช็คปู: ใช้เป็น "พักเตือนถึง" หลังกดเสร็จแล้ว
  nextDueAt  DateTime?
  lastDoneAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  tasks Task[]

  @@unique([systemId, defaultKey])
  @@index([ownerId, active, nextDueAt])
}

/// งาน 1 รอบ — "วันนี้" = งานที่ยังเปิด (OPEN) · ประวัติ = งานที่ปิดแล้ว
model Task {
  id        Int           @id @default(autoincrement())
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   Int
  system    CrabSystem?   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  systemId  Int?
  rule      ReminderRule? @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId    Int?
  kind      ReminderKind
  title     String
  priority  Priority
  dueAt     DateTime
  status    TaskStatus    @default(OPEN)
  doneAt    DateTime?
  closedBy  TaskCloser?
  /// กันงานซ้ำตอนสองเครื่องเปิดพร้อมกัน: มีค่าเฉพาะตอนงานยังเปิด ("rule:12" / "lot:5") ปิดแล้ว = null
  openKey   String?       @unique
  /// อ้างอิงของงานอัตโนมัติ เช่น id ล็อตของงาน "ใส่ราคาล็อต"
  refId     Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([ownerId, status, dueAt])
  @@index([ruleId, status])
}

enum ReminderKind {
  WATER_TEST // วัดค่าน้ำ (P5 ปิดเองเมื่อบันทึกค่าน้ำ)
  FEEDING // รอบให้อาหาร (P4 ตามแผนให้อาหาร)
  CRAB_CHECK // เช็คเนื้อ/ไข่ปู — มีงานเมื่อมีปูถึงรอบ ปิดเองเมื่อเช็คครบ
  MICROBES // ใส่จุลินทรีย์
  FRESHWATER // เติมน้ำจืด
  FILTER // เปลี่ยนใยกรองละเอียด
  CUSTOM // เรื่องที่ผู้ใช้ตั้งเอง
  LOT_COST // งานอัตโนมัติ: ใส่ราคาล็อต (ไม่มีกฎ ปิดเองเมื่อใส่ราคา)
  FEED_LOW // งานอัตโนมัติ: อาหารเหลือพอไม่ถึง 2 รอบ (ปิดเองเมื่อซื้อเพิ่ม)
}

enum Priority {
  HIGH // ด่วนมาก — ป๊อปอัปทุก 1 ชม. จนกว่าจะทำ
  MEDIUM // ปานกลาง
  LOW // ทั่วไป
}

enum RepeatType {
  EVERY_DAYS // ทุก N วัน (นับจากวันที่ทำจริง)
  WEEKDAYS // ทุกวันจันทร์/พฤหัส ฯลฯ
  ONCE // ครั้งเดียว
  FEEDING_PLAN // ตามแผนให้อาหาร (P4)
}

enum TaskStatus {
  OPEN
  DONE
  SKIPPED
}

enum TaskCloser {
  USER // ผู้ใช้กดเสร็จ/ข้าม
  AUTO // ระบบปิดให้ (บันทึกจริงแล้ว / ใส่ราคาแล้ว / ไม่มีปูถึงรอบแล้ว)
}

// ─────────────────────────────────────────────────────────────────────
//  อาหารปู (P4) — สต็อก (ต่อเจ้าของ ใช้ร่วมทุกระบบ) · แผน (ต่อระบบ) · รอบ · ผลการกินรายตัว
//  - รอบเปิดได้ทีละรอบต่อระบบ: ถึงเวลารอบใหม่แล้วรอบเก่ายังเปิด → ปิดให้เอง (autoClosed) แล้วถามยืนยันครั้งเดียว
//  - ทุกตัวเริ่มที่ "กินหมด" (สร้างแถวผลการกินให้ตอนเปิดรอบ) ผู้ใช้แตะเฉพาะตัวที่มีปัญหา
//  - เก็บอาหาร "รายตัว" (FeedingEntry.itemId) ไม่ใช่รายรอบ → แบ่งกล่องให้คนละอาหารได้ + ใช้วิเคราะห์ (P7)
//  - ปิดรอบ = ตัดสต็อกจากแถวผลการกิน (แก้ย้อนหลัง/ไม่ได้ให้ = คำนวณสต็อกใหม่ให้)
// ─────────────────────────────────────────────────────────────────────

/// ชนิดอาหาร + จำนวนคงเหลือ — ค่าเริ่มต้น "ปลา" / "หอย" หน่วยชิ้น (สร้างให้ตอนใช้ครั้งแรก)
model FeedItem {
  id        Int      @id @default(autoincrement())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   Int
  name      String
  emoji     String?
  unit      String   @default("ชิ้น")
  /// คงเหลือ — มีความหมายเมื่อ stockSet = true
  qty       Decimal  @default(0) @db.Decimal(10, 1)
  /// เคยใส่จำนวนแล้ว (ซื้อ/นับใหม่) — ยังไม่เคย = ไม่ตัดสต็อก ไม่เตือนใกล้หมด (ไม่บังคับใส่สต็อก)
  stockSet  Boolean  @default(false)
  /// false = ซ่อน (ลบ) — เก็บแถวไว้เพราะประวัติการให้อาหารอ้างถึง
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moves        FeedStockMove[]
  entries      FeedingEntry[]
  plansMain    FeedingPlan[]    @relation("PlanMainItem")
  plansAlt     FeedingPlan[]    @relation("PlanAltItem")
  planDayItems FeedingPlanDay[]

  @@unique([ownerId, name])
}

/// ความเคลื่อนไหวสต็อก: ซื้อ (+) · ใช้ตอนปิดรอบ (−) · นับใหม่ (± ส่วนต่าง)
model FeedStockMove {
  id        Int           @id @default(autoincrement())
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   Int
  item      FeedItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int
  kind      StockMoveKind
  qty       Decimal       @db.Decimal(10, 1)
  /// ราคาที่จ่าย (ซื้อ) — P6 ลงบัญชีให้เอง
  priceTHB  Decimal?      @db.Decimal(12, 2)
  round     FeedingRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  roundId   Int?
  note      String?       @db.Text
  at        DateTime      @default(now())
  createdAt DateTime      @default(now())

  @@index([itemId, at])
  @@index([roundId])
}

enum StockMoveKind {
  BUY
  USE
  ADJUST
}

/// แผนให้อาหาร 1 ระบบ = 1 แผน — วงรอบ "ให้ N วัน เว้น M วัน" + อาหาร (อย่างเดียว / สลับ 2 อย่าง) + ปรับรายวัน
model FeedingPlan {
  id            Int         @id @default(autoincrement())
  owner         User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       Int
  system        CrabSystem  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  systemId      Int         @unique
  active        Boolean     @default(true)
  onDays        Int         @default(1)
  /// 0 = ให้ทุกวัน
  offDays       Int         @default(1)
  /// วันแรกของช่วง "ให้" — จุดอ้างอิงวงรอบ
  anchorDate    DateTime
  timeOfDay     String      @default("18:00")
  pattern       FeedPattern @default(SINGLE)
  item          FeedItem?   @relation("PlanMainItem", fields: [itemId], references: [id], onDelete: SetNull)
  itemId        Int?
  /// อาหารอย่างที่ 2 (แบบสลับ)
  altItem       FeedItem?   @relation("PlanAltItem", fields: [altItemId], references: [id], onDelete: SetNull)
  altItemId     Int?
  piecesPerCrab Decimal     @default(1) @db.Decimal(4, 1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  days FeedingPlanDay[]
}

enum FeedPattern {
  SINGLE // อาหารอย่างเดียวทุกรอบ
  ALTERNATE // สลับ 2 อย่างทีละรอบ
}

/// ปรับแผนรายวัน: เปลี่ยนอาหารวันนั้น / "วันนี้ไม่ให้อาหาร"
model FeedingPlanDay {
  id     Int         @id @default(autoincrement())
  plan   FeedingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId Int
  /// "YYYY-MM-DD" (วันไทย)
  date   String      @db.Char(10)
  skip   Boolean     @default(false)
  item   FeedItem?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId Int?

  @@unique([planId, date])
}

/// รอบให้อาหาร 1 วัน — เปิดเมื่อถึงเวลาให้อาหาร (หรือกด "เริ่มให้อาหาร" ก่อนได้)
model FeedingRound {
  id            Int         @id @default(autoincrement())
  owner         User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId       Int
  system        CrabSystem  @relation(fields: [systemId], references: [id], onDelete: Cascade)
  systemId      Int
  /// "YYYY-MM-DD" (วันไทย) — 1 ระบบ 1 รอบต่อวัน
  feedDate      String      @db.Char(10)
  dueAt         DateTime
  status        RoundStatus @default(OPEN)
  /// กด "ให้อาหารแล้ว" (แจ้งเตือนให้อาหารปิดตอนนี้) — ต่อจากนี้คือช่วงเก็บเศษ/บันทึกการกิน
  fedAt         DateTime?
  closedAt      DateTime?
  /// ระบบปิดให้เพราะถึงรอบใหม่แล้วยังไม่ได้ปิด (ตัวที่ไม่ได้บันทึก = กินหมด)
  autoClosed    Boolean     @default(false)
  /// รอให้ผู้ใช้ยืนยันรอบที่ปิดให้ (ถูกต้อง / แก้ย้อนหลัง / วันนั้นไม่ได้ให้อาหาร)
  reviewPending Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  entries FeedingEntry[]
  moves   FeedStockMove[]

  @@unique([systemId, feedDate])
  @@index([ownerId, status])
}

enum RoundStatus {
  OPEN
  DONE
  SKIPPED // วันนั้นไม่ได้ให้อาหาร
}

/// ปู 1 ตัวในรอบ 1 รอบ: ได้อาหารอะไร กี่ชิ้น กินไหม — สร้างตอนเปิดรอบ (เริ่มที่ "กินหมด")
model FeedingEntry {
  id        Int          @id @default(autoincrement())
  round     FeedingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId   Int
  crab      Crab         @relation(fields: [crabId], references: [id], onDelete: Cascade)
  crabId    Int
  /// กล่องตอนให้อาหาร (ปูอาจย้ายทีหลัง)
  boxId     Int?
  item      FeedItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId    Int?
  pieces    Decimal      @default(1) @db.Decimal(4, 1)
  result    EatResult    @default(ATE)
  updatedAt DateTime     @updatedAt

  @@unique([roundId, crabId])
  @@index([crabId])
}

enum EatResult {
  ATE // กินหมด
  LITTLE // กินน้อย
  NONE // ไม่กิน
}
